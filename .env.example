APP_NAME="Kiki Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Local Database (Default: SQLite for fast offline dev)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Supabase Production Database (PostgreSQL Connection Pooler)
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.your_project_ref
# DB_PASSWORD=your_database_password
# DB_SSLMODE=require

# Persistent Session Driver
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Filesystem & Storage Configuration
# Local: public / Production on Vercel: supabase or s3
FILESYSTEM_DISK=public
# Set FILESYSTEM_DISK=supabase in Vercel environment variables. Configure the
# Supabase Storage S3 credentials below and make the portfolio-media bucket public.

# Supabase Storage S3-Compatible Credentials
# Get these from Supabase Dashboard > Project Settings > Storage > S3 Access Keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=portfolio-media
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
AWS_URL=https://your-project-ref.supabase.co/storage/v1/object/public/portfolio-media

# Cache & Queues
CACHE_STORE=database
QUEUE_CONNECTION=database

# Mail Settings (Optional for contact notification)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
